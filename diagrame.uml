  <line x1="480" y1="242" x2="630" y2="242" stroke="#993C1D" stroke-width="0.5"/>
  <text font-size="12" x="495" y="258" dominant-baseline="central" fill="#993C1D">id: UUID</text>
  <text font-size="12" x="495" y="276" dominant-baseline="central" fill="#993C1D">name, value</text>
  <text font-size="12" x="495" y="294" dominant-baseline="central" fill="#993C1D">currency: String</text>

  <line x1="420" y1="250" x2="478" y2="250" stroke="#888780" stroke-width="0.5" marker-end="url(#arrow)"/>
  <text font-size="12" x="444" y="244" fill="#5F5E5A">n..m</text>

  <rect x="40" y="430" width="170" height="100" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="125" y="450" text-anchor="middle" dominant-baseline="central" fill="#633806">AIValidation</text>
  <line x1="40" y1="462" x2="210" y2="462" stroke="#854F0B" stroke-width="0.5"/>
  <text font-size="12" x="55" y="478" dominant-baseline="central" fill="#854F0B">id: UUID</text>
  <text font-size="12" x="55" y="496" dominant-baseline="central" fill="#854F0B">isValid: Boolean</text>
  <text font-size="12" x="55" y="514" dominant-baseline="central" fill="#854F0B">reason: String</text>

  <line x1="120" y1="350" x2="120" y2="428" stroke="#888780" stroke-width="0.5" stroke-dasharray="4 3" marker-end="url(#arrow)"/>

  <rect x="270" y="430" width="170" height="100" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="355" y="450" text-anchor="middle" dominant-baseline="central" fill="#633806">AISuggestion</text>
  <line x1="270" y1="462" x2="440" y2="462" stroke="#854F0B" stroke-width="0.5"/>
  <text font-size="12" x="285" y="478" dominant-baseline="central" fill="#854F0B">id: UUID</text>
  <text font-size="12" x="285" y="496" dominant-baseline="central" fill="#854F0B">description: String</text>
  <text font-size="12" x="285" y="514" dominant-baseline="central" fill="#854F0B">amount: BigDecimal</text>

  <line x1="340" y1="324" x2="340" y2="428" stroke="#888780" stroke-width="0.5" stroke-dasharray="4 3" marker-end="url(#arrow)"/>

  <rect x="490" y="430" width="150" height="100" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="565" y="450" text-anchor="middle" dominant-baseline="central" fill="#633806">Allocation</text>
  <line x1="490" y1="462" x2="640" y2="462" stroke="#854F0B" stroke-width="0.5"/>
  <text font-size="12" x="505" y="478" dominant-baseline="central" fill="#854F0B">walletId: UUID</text>
  <text font-size="12" x="505" y="496" dominant-baseline="central" fill="#854F0B">amount: BigDecimal</text>
  <text font-size="12" x="505" y="514" dominant-baseline="central" fill="#854F0B">reason: String</text>

  <line x1="555" y1="310" x2="555" y2="428" stroke="#888780" stroke-width="0.5" stroke-dasharray="4 3" marker-end="url(#arrow)"/>

  <text font-size="12" x="340" y="565" text-anchor="middle" fill="#5F5E5A">Linii continue = relatii de date | Linii punctate = generat de AI</text>
</svg>

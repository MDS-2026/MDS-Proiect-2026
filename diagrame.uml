## 2. Diagrama arhitecturii componentelor

```svg
<svg width="100%" viewBox="0 0 680 660" role="img">
  <title>Diagrama arhitecturii componentelor — Group Wallet</title>
  <desc>Frontend React+Vite, Backend Spring Boot, Agenti AI, persistenta PostgreSQL.</desc>
  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </marker>
  </defs>

  <rect x="40" y="30" width="600" height="150" rx="14" fill="none" stroke="#378ADD" stroke-width="0.5" stroke-dasharray="5 4"/>
  <text font-size="12" x="56" y="50" fill="#185FA5">Frontend — React + Vite</text>
  <rect x="60" y="60" width="130" height="44" rx="8" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="125" y="82" text-anchor="middle" dominant-baseline="central" fill="#0C447C">Auth / Register</text>
  <rect x="210" y="60" width="130" height="44" rx="8" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="275" y="82" text-anchor="middle" dominant-baseline="central" fill="#0C447C">Group Dashboard</text>
  <rect x="360" y="60" width="130" height="44" rx="8" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="425" y="82" text-anchor="middle" dominant-baseline="central" fill="#0C447C">Wallet View</text>
  <rect x="510" y="60" width="110" height="44" rx="8" fill="#E6F1FB" stroke="#185FA5" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="565" y="82" text-anchor="middle" dominant-baseline="central" fill="#0C447C">AI Suggestions</text>
  <rect x="230" y="120" width="220" height="40" rx="8" fill="#F1EFE8" stroke="#5F5E5A" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="340" y="140" text-anchor="middle" dominant-baseline="central" fill="#444441">REST API Client (Axios)</text>

  <line x1="340" y1="180" x2="340" y2="214" stroke="#378ADD" stroke-width="0.5" marker-end="url(#arrow)"/>

  <rect x="40" y="218" width="600" height="160" rx="14" fill="none" stroke="#1D9E75" stroke-width="0.5" stroke-dasharray="5 4"/>
  <text font-size="12" x="56" y="238" fill="#0F6E56">Backend — Spring Boot (Java)</text>
  <rect x="60" y="248" width="160" height="44" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="140" y="262" text-anchor="middle" dominant-baseline="central" fill="#085041">REST API</text>
  <text font-size="12" x="140" y="280" text-anchor="middle" fill="#0F6E56">/groups /wallets /tx /ai</text>
  <rect x="250" y="248" width="140" height="44" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="320" y="270" text-anchor="middle" dominant-baseline="central" fill="#085041">Group Service</text>
  <rect x="410" y="248" width="140" height="44" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="480" y="270" text-anchor="middle" dominant-baseline="central" fill="#085041">Wallet Service</text>
  <rect x="155" y="314" width="160" height="44" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="235" y="336" text-anchor="middle" dominant-baseline="central" fill="#085041">Transaction Service</text>
  <rect x="355" y="314" width="160" height="44" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="435" y="336" text-anchor="middle" dominant-baseline="central" fill="#085041">AI Orchestrator</text>

  <line x1="220" y1="270" x2="248" y2="270" stroke="#1D9E75" stroke-width="0.5" marker-end="url(#arrow)"/>
  <line x1="390" y1="270" x2="408" y2="270" stroke="#1D9E75" stroke-width="0.5" marker-end="url(#arrow)"/>
  <line x1="340" y1="380" x2="340" y2="414" stroke="#1D9E75" stroke-width="0.5" marker-end="url(#arrow)"/>
  <line x1="435" y1="380" x2="435" y2="414" stroke="#1D9E75" stroke-width="0.5" stroke-dasharray="4 3" marker-end="url(#arrow)"/>

  <rect x="40" y="418" width="600" height="130" rx="14" fill="none" stroke="#BA7517" stroke-width="0.5" stroke-dasharray="5 4"/>
  <text font-size="12" x="56" y="438" fill="#854F0B">Agenti AI</text>
  <rect x="60" y="448" width="140" height="56" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="130" y="465" text-anchor="middle" dominant-baseline="central" fill="#633806">AI Validator</text>
  <text font-size="12" x="130" y="483" text-anchor="middle" fill="#854F0B">scop portofele</text>
  <rect x="225" y="448" width="160" height="56" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="305" y="465" text-anchor="middle" dominant-baseline="central" fill="#633806">Resource Allocator</text>
  <text font-size="12" x="305" y="483" text-anchor="middle" fill="#854F0B">imparte asseturi</text>
  <rect x="410" y="448" width="160" height="56" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="490" y="465" text-anchor="middle" dominant-baseline="central" fill="#633806">Suggestion Agent</text>
  <text font-size="12" x="490" y="483" text-anchor="middle" fill="#854F0B">sugestii per wallet</text>

  <line x1="340" y1="548" x2="340" y2="582" stroke="#888780" stroke-width="0.5" marker-end="url(#arrow)"/>

  <rect x="40" y="586" width="600" height="56" rx="14" fill="none" stroke="#888780" stroke-width="0.5" stroke-dasharray="5 4"/>
  <text font-size="12" x="56" y="604" fill="#5F5E5A">Persistenta</text>
  <rect x="180" y="600" width="140" height="30" rx="6" fill="#F1EFE8" stroke="#5F5E5A" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="250" y="615" text-anchor="middle" dominant-baseline="central" fill="#444441">PostgreSQL / H2</text>
  <rect x="350" y="600" width="160" height="30" rx="6" fill="#F1EFE8" stroke="#5F5E5A" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="430" y="615" text-anchor="middle" dominant-baseline="central" fill="#444441">JPA Repositories</text>
</svg>
```


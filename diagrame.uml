## 3. Diagrama de clase / model de domeniu

```svg
<svg width="100%" viewBox="0 0 680 580" role="img">
  <title>Model de domeniu — Group Wallet</title>
  <desc>Entitati principale: User, Group, Wallet, Transaction, Asset, AIValidation, AISuggestion.</desc>
  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </marker>
  </defs>

  <rect x="40" y="40" width="150" height="100" rx="8" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="115" y="60" text-anchor="middle" dominant-baseline="central" fill="#3C3489">User</text>
  <line x1="40" y1="72" x2="190" y2="72" stroke="#534AB7" stroke-width="0.5"/>
  <text font-size="12" x="55" y="88" dominant-baseline="central" fill="#534AB7">id: UUID</text>
  <text font-size="12" x="55" y="106" dominant-baseline="central" fill="#534AB7">email, passwordHash</text>
  <text font-size="12" x="55" y="124" dominant-baseline="central" fill="#534AB7">role: MEMBER | ADMIN</text>

  <rect x="260" y="40" width="160" height="100" rx="8" fill="#EEEDFE" stroke="#534AB7" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="340" y="60" text-anchor="middle" dominant-baseline="central" fill="#3C3489">Group</text>
  <line x1="260" y1="72" x2="420" y2="72" stroke="#534AB7" stroke-width="0.5"/>
  <text font-size="12" x="275" y="88" dominant-baseline="central" fill="#534AB7">id: UUID</text>
  <text font-size="12" x="275" y="106" dominant-baseline="central" fill="#534AB7">name, inviteCode</text>
  <text font-size="12" x="275" y="124" dominant-baseline="central" fill="#534AB7">createdAt: Date</text>

  <line x1="190" y1="80" x2="258" y2="80" stroke="#888780" stroke-width="0.5" marker-end="url(#arrow)"/>
  <text font-size="12" x="224" y="74" fill="#5F5E5A">n..m</text>

  <rect x="260" y="210" width="160" height="114" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="340" y="230" text-anchor="middle" dominant-baseline="central" fill="#085041">Wallet</text>
  <line x1="260" y1="242" x2="420" y2="242" stroke="#0F6E56" stroke-width="0.5"/>
  <text font-size="12" x="275" y="258" dominant-baseline="central" fill="#0F6E56">id: UUID</text>
  <text font-size="12" x="275" y="276" dominant-baseline="central" fill="#0F6E56">name, purpose</text>
  <text font-size="12" x="275" y="294" dominant-baseline="central" fill="#0F6E56">balance: BigDecimal</text>
  <text font-size="12" x="275" y="312" dominant-baseline="central" fill="#0F6E56">type: PARENT | SUB</text>

  <line x1="340" y1="140" x2="340" y2="208" stroke="#888780" stroke-width="0.5" marker-end="url(#arrow)"/>
  <text font-size="12" x="346" y="178" fill="#5F5E5A">1..n</text>

  <rect x="40" y="250" width="160" height="100" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="120" y="270" text-anchor="middle" dominant-baseline="central" fill="#085041">Transaction</text>
  <line x1="40" y1="282" x2="200" y2="282" stroke="#0F6E56" stroke-width="0.5"/>
  <text font-size="12" x="55" y="298" dominant-baseline="central" fill="#0F6E56">id: UUID</text>
  <text font-size="12" x="55" y="316" dominant-baseline="central" fill="#0F6E56">amount, currency</text>
  <text font-size="12" x="55" y="334" dominant-baseline="central" fill="#0F6E56">status, timestamp</text>

  <line x1="200" y1="290" x2="258" y2="290" stroke="#888780" stroke-width="0.5" marker-end="url(#arrow)"/>
  <text font-size="12" x="224" y="284" fill="#5F5E5A">n..1</text>

  <rect x="480" y="210" width="150" height="100" rx="8" fill="#FAECE7" stroke="#993C1D" stroke-width="0.5"/>

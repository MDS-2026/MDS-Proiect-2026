## 5. Workflow logic al agentilor AI

```svg
<svg width="100%" viewBox="0 0 680 640" role="img">
  <title>Workflow logic al agentilor AI — Group Wallet</title>
  <desc>AI Orchestrator coordoneaza AI Validator, Resource Allocator si Suggestion Agent.</desc>
  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </marker>
  </defs>

  <rect x="230" y="20" width="220" height="44" rx="8" fill="#F1EFE8" stroke="#5F5E5A" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="340" y="42" text-anchor="middle" dominant-baseline="central" fill="#444441">AI Orchestrator</text>

  <line x1="280" y1="64" x2="180" y2="110" stroke="#888780" stroke-width="0.5" marker-end="url(#arrow)"/>
  <line x1="340" y1="64" x2="340" y2="110" stroke="#888780" stroke-width="0.5" marker-end="url(#arrow)"/>
  <line x1="400" y1="64" x2="500" y2="110" stroke="#888780" stroke-width="0.5" marker-end="url(#arrow)"/>

  <rect x="60" y="108" width="580" height="200" rx="12" fill="none" stroke="#B4B2A9" stroke-width="0.5" stroke-dasharray="5 4"/>
  <text font-size="12" x="80" y="124" fill="#5F5E5A">Agenti paraleli</text>

  <rect x="80" y="132" width="160" height="140" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="160" y="156" text-anchor="middle" dominant-baseline="central" fill="#633806">AI Validator</text>
  <line x1="80" y1="168" x2="240" y2="168" stroke="#854F0B" stroke-width="0.5"/>
  <text font-size="12" x="95" y="186" dominant-baseline="central" fill="#854F0B">Input:</text>
  <text font-size="12" x="95" y="204" dominant-baseline="central" fill="#854F0B">tranzactie + scop</text>
  <text font-size="12" x="95" y="222" dominant-baseline="central" fill="#854F0B">portofel</text>
  <text font-size="12" x="95" y="244" dominant-baseline="central" fill="#854F0B">Output: valid/invalid</text>

  <rect x="260" y="132" width="160" height="140" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="340" y="152" text-anchor="middle" dominant-baseline="central" fill="#633806">Resource</text>
  <text font-size="14" font-weight="500" x="340" y="168" text-anchor="middle" dominant-baseline="central" fill="#633806">Allocator</text>
  <line x1="260" y1="180" x2="420" y2="180" stroke="#854F0B" stroke-width="0.5"/>
  <text font-size="12" x="275" y="198" dominant-baseline="central" fill="#854F0B">Input:</text>
  <text font-size="12" x="275" y="216" dominant-baseline="central" fill="#854F0B">asseturi grup</text>
  <text font-size="12" x="275" y="234" dominant-baseline="central" fill="#854F0B">+ scopuri portofele</text>
  <text font-size="12" x="275" y="254" dominant-baseline="central" fill="#854F0B">Output: % alocare</text>

  <rect x="440" y="132" width="180" height="140" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="530" y="152" text-anchor="middle" dominant-baseline="central" fill="#633806">Suggestion</text>
  <text font-size="14" font-weight="500" x="530" y="168" text-anchor="middle" dominant-baseline="central" fill="#633806">Agent</text>
  <line x1="440" y1="180" x2="620" y2="180" stroke="#854F0B" stroke-width="0.5"/>
  <text font-size="12" x="455" y="198" dominant-baseline="central" fill="#854F0B">Input:</text>
  <text font-size="12" x="455" y="216" dominant-baseline="central" fill="#854F0B">scop + buget</text>
  <text font-size="12" x="455" y="234" dominant-baseline="central" fill="#854F0B">portofele</text>
  <text font-size="12" x="455" y="254" dominant-baseline="central" fill="#854F0B">Output: lista sugestii</text>

  <line x1="160" y1="272" x2="230" y2="340" stroke="#888780" stroke-width="0.5" marker-end="url(#arrow)"/>
  <line x1="340" y1="272" x2="340" y2="340" stroke="#888780" stroke-width="0.5" marker-end="url(#arrow)"/>
  <line x1="530" y1="272" x2="450" y2="340" stroke="#888780" stroke-width="0.5" marker-end="url(#arrow)"/>

  <rect x="180" y="344" width="320" height="56" rx="8" fill="#F1EFE8" stroke="#5F5E5A" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="340" y="364" text-anchor="middle" dominant-baseline="central" fill="#444441">Agregare rezultate</text>
  <text font-size="12" x="340" y="384" text-anchor="middle" dominant-baseline="central" fill="#5F5E5A">Orchestrator combina raspunsurile</text>

  <line x1="290" y1="400" x2="230" y2="440" stroke="#888780" stroke-width="0.5" marker-end="url(#arrow)"/>
  <line x1="390" y1="400" x2="450" y2="440" stroke="#888780" stroke-width="0.5" marker-end="url(#arrow)"/>

  <rect x="80" y="444" width="200" height="56" rx="8" fill="#FCEBEB" stroke="#A32D2D" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="180" y="464" text-anchor="middle" dominant-baseline="central" fill="#791F1F">Tranzactie blocata</text>
  <text font-size="12" x="180" y="484" text-anchor="middle" dominant-baseline="central" fill="#A32D2D">motiv + recomandare</text>

  <rect x="400" y="444" width="200" height="56" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="500" y="464" text-anchor="middle" dominant-baseline="central" fill="#085041">Raspuns complet</text>
  <text font-size="12" x="500" y="484" text-anchor="middle" dominant-baseline="central" fill="#0F6E56">valid + alocare + sugestii</text>

  <line x1="180" y1="500" x2="180" y2="544" stroke="#888780" stroke-width="0.5" marker-end="url(#arrow)"/>
  <line x1="500" y1="500" x2="500" y2="544" stroke="#888780" stroke-width="0.5" marker-end="url(#arrow)"/>

  <rect x="80" y="548" width="560" height="56" rx="8" fill="#F1EFE8" stroke="#5F5E5A" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="360" y="568" text-anchor="middle" dominant-baseline="central" fill="#444441">Frontend — afiseaza rezultat utilizatorului</text>
  <text font-size="12" x="360" y="588" text-anchor="middle" dominant-baseline="central" fill="#5F5E5A">card agent + verdict + sugestii tranzactii</text>
</svg>
```
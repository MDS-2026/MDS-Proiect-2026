## 4. Diagrama de stare: ciclul unei tranzactii

```svg
<svg width="100%" viewBox="0 0 680 620" role="img">
  <title>Diagrama de stare — ciclul unei tranzactii</title>
  <desc>Starile prin care trece o tranzactie: initiata, validare AI, aprobata sau respinsa, executata, istorica.</desc>
  <defs>
    <marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
    </marker>
  </defs>

  <circle cx="340" cy="40" r="14" fill="#2C2C2A"/>

  <line x1="340" y1="54" x2="340" y2="84" stroke="#888780" stroke-width="0.5" marker-end="url(#arrow)"/>

  <rect x="230" y="88" width="220" height="56" rx="8" fill="#F1EFE8" stroke="#5F5E5A" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="340" y="108" text-anchor="middle" dominant-baseline="central" fill="#444441">INITIATA</text>
  <text font-size="12" x="340" y="128" text-anchor="middle" dominant-baseline="central" fill="#5F5E5A">utilizator completeaza suma si scop</text>

  <line x1="340" y1="144" x2="340" y2="180" stroke="#888780" stroke-width="0.5" marker-end="url(#arrow)"/>
  <text font-size="12" x="350" y="166" fill="#5F5E5A">trimite</text>

  <rect x="210" y="184" width="260" height="56" rx="8" fill="#FAEEDA" stroke="#854F0B" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="340" y="204" text-anchor="middle" dominant-baseline="central" fill="#633806">IN_VALIDARE_AI</text>
  <text font-size="12" x="340" y="224" text-anchor="middle" dominant-baseline="central" fill="#854F0B">AI verifica scopul vs portofel</text>

  <path d="M210 212 L130 212 L130 316 L228 316" fill="none" stroke="#E24B4A" stroke-width="0.5" marker-end="url(#arrow)"/>
  <text font-size="12" x="90" y="264" text-anchor="middle" fill="#A32D2D">scop</text>
  <text font-size="12" x="90" y="278" text-anchor="middle" fill="#A32D2D">incompatibil</text>

  <rect x="228" y="292" width="160" height="56" rx="8" fill="#FCEBEB" stroke="#A32D2D" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="308" y="312" text-anchor="middle" dominant-baseline="central" fill="#791F1F">RESPINSA</text>
  <text font-size="12" x="308" y="332" text-anchor="middle" dominant-baseline="central" fill="#A32D2D">motiv afisat utilizatorului</text>

  <line x1="470" y1="212" x2="530" y2="212" stroke="#1D9E75" stroke-width="0.5" marker-end="url(#arrow)"/>
  <text font-size="12" x="490" y="204" fill="#0F6E56">scop valid</text>

  <rect x="530" y="184" width="120" height="56" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="590" y="204" text-anchor="middle" dominant-baseline="central" fill="#085041">APROBATA</text>
  <text font-size="12" x="590" y="222" text-anchor="middle" dominant-baseline="central" fill="#0F6E56">AI confirmat</text>

  <line x1="590" y1="240" x2="590" y2="292" stroke="#888780" stroke-width="0.5" marker-end="url(#arrow)"/>
  <text font-size="12" x="600" y="270" fill="#5F5E5A">executa</text>

  <rect x="510" y="296" width="160" height="56" rx="8" fill="#E1F5EE" stroke="#0F6E56" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="590" y="316" text-anchor="middle" dominant-baseline="central" fill="#085041">IN_EXECUTIE</text>
  <text font-size="12" x="590" y="334" text-anchor="middle" dominant-baseline="central" fill="#0F6E56">balance actualizat</text>

  <line x1="590" y1="352" x2="590" y2="404" stroke="#888780" stroke-width="0.5" marker-end="url(#arrow)"/>

  <rect x="510" y="408" width="160" height="56" rx="8" fill="#EAF3DE" stroke="#3B6D11" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="590" y="428" text-anchor="middle" dominant-baseline="central" fill="#27500A">EXECUTATA</text>
  <text font-size="12" x="590" y="446" text-anchor="middle" dominant-baseline="central" fill="#3B6D11">salvata in istoric</text>

  <path d="M510 436 L430 436 L430 352 L388 352" fill="none" stroke="#E24B4A" stroke-width="0.5" stroke-dasharray="4 3" marker-end="url(#arrow)"/>
  <text font-size="12" x="420" y="398" text-anchor="middle" fill="#A32D2D">eroare</text>
  <text font-size="12" x="420" y="412" text-anchor="middle" fill="#A32D2D">fonduri</text>

  <rect x="248" y="328" width="140" height="40" rx="8" fill="#FCEBEB" stroke="#A32D2D" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="318" y="348" text-anchor="middle" dominant-baseline="central" fill="#791F1F">ESUAT</text>

  <line x1="590" y1="464" x2="590" y2="510" stroke="#888780" stroke-width="0.5" marker-end="url(#arrow)"/>
  <line x1="308" y1="349" x2="308" y2="510" stroke="#B4B2A9" stroke-width="0.5" stroke-dasharray="4 3" marker-end="url(#arrow)"/>

  <rect x="200" y="514" width="380" height="56" rx="8" fill="#F1EFE8" stroke="#5F5E5A" stroke-width="0.5"/>
  <text font-size="14" font-weight="500" x="390" y="534" text-anchor="middle" dominant-baseline="central" fill="#444441">ARHIVATA</text>
  <text font-size="12" x="390" y="554" text-anchor="middle" dominant-baseline="central" fill="#5F5E5A">vizibila in dashboardul grupului</text>

  <circle cx="390" cy="600" r="10" fill="none" stroke="#2C2C2A" stroke-width="1.5"/>
  <circle cx="390" cy="600" r="6" fill="#2C2C2A"/>
  <line x1="390" y1="570" x2="390" y2="588" stroke="#888780" stroke-width="0.5" marker-end="url(#arrow)"/>
</svg>
```

